# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional signing secret (automatically generated securely into instance/session.secret if left blank)
SESSION_SECRET=""

# --- Free OSINT API Enhancers (all work without keys; optional free keys raise rate limits or unlock URLhaus) ---
# Optional free GitHub Personal Access Token (raises search rate limit from 10/min to 30/min)
GITHUB_TOKEN=""
# Optional free NIST NVD API Key (raises rate limit from 5/30s to 50/30s): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=""
# Free abuse.ch Auth-Key for URLhaus Threat Intelligence: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=""

# --- Paid / Billing-Gated Optional APIs (not required; missing keys are reported transparently) ---
# Brave Web Search API (requires billing-enabled Brave plan after free credit grant)
BRAVE_API_KEY=""
# Have I Been Pwned Email Breach Lookup v3 (requires paid HIBP subscription; Pwned Passwords range check is free without a key)
HIBP_API_KEY=""

# Optional Reviewer Audit Console passcode (can also be claimed on first run in the UI)
REVIEWER_PASSCODE=""
# Optional bootstrap token required when claiming first-run reviewer passcode in production
REVIEWER_BOOTSTRAP_TOKEN=""

# Optional SMTP delivery for email verification links
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
MAIL_FROM=""
PUBLIC_BASE_URL=""

# Optional Google OpenID Connect linking
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional real public-web search provider (no synthetic fallback)
TAVILY_API_KEY=""

# Optional Google Programmable Search (real public-web search; requires both values)
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""

# XposedOrNot public breach API is queried without an API key when email is supplied.
# HIBP email breach lookup remains optional and requires a paid API key.
